<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="10dp"
    android:paddingBottom="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFF"
            android:contentDescription="返回"
            android:padding="10dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="設定"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_weight="1">
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:background="@drawable/bg_session_connection">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="字體大小"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_weight="1" />
                    <TextView
                        android:id="@+id/tvFontSizeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24 sp"
                        android:textColor="#BBBBBB"
                        android:textSize="14sp" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seekFontSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="12"
                    android:progress="2"
                    android:progressTint="#4CAF50"
                    android:thumbTint="#4CAF50"
                    android:minHeight="36dp" />
                <TextView
                    android:id="@+id/tvFontPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="字幕預覽"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="#1D2123"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
                <Button
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="儲存設定"
                    android:textSize="16sp"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:minHeight="48dp"
                    android:layout_marginTop="3dp" />
                <TextView
                    android:id="@+id/tvTtsEngineLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TTS 引擎"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp" />
                <Spinner
                    android:id="@+id/spinnerTtsEngine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_spinner_background"
                    android:popupBackground="@drawable/bg_spinner_popup"
                    android:layout_marginTop="4dp"
                    android:minHeight="42dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp">
                    <Button
                        android:id="@+id/btnTtsSetup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="語音資料 / 設定"
                        android:textSize="14sp"
                        android:backgroundTint="#455A64"
                        android:textColor="#FFFFFF"
                        android:minHeight="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp" />
                    <Button
                        android:id="@+id/btnTtsTest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="測試語音"
                        android:textSize="14sp"
                        android:backgroundTint="#607D8B"
                        android:textColor="#FFFFFF"
                        android:minHeight="48dp"
                        android:layout_weight="1" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:id="@+id/tvCurrentRole"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="目前身份：尚未選擇"
                        android:textColor="#BBBBBB"
                        android:textSize="14sp"
                        android:layout_weight="1" />
                    <Button
                        android:id="@+id/btnSwitchRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="切換身份"
                        android:textSize="14sp"
                        android:backgroundTint="#455A64"
                        android:textColor="#FFFFFF"
                        android:minHeight="48dp"
                        android:layout_marginEnd="6dp" />
                    <Button
                        android:id="@+id/btnDebugPage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="除錯"
                        android:textSize="14sp"
                        android:backgroundTint="#8D6E63"
                        android:textColor="#FFFFFF"
                        android:minHeight="48dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginStart="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:layout_weight="1"
                android:padding="12dp"
                android:background="@drawable/bg_session_connection"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/tvSpeakerSectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="聲紋註冊"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_weight="1" />
                    <Button
                        android:id="@+id/btnAddSpeaker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="新增說話者"
                        android:textSize="14sp"
                        android:backgroundTint="#455A64"
                        android:textColor="#FFFFFF"
                        android:minHeight="48dp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvNoSpeakersHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="目前尚未註冊說話者"
                    android:textColor="#C4CBCD"
                    android:textSize="14sp"
                    android:background="@android:color/transparent"
                    android:visibility="gone"
                    android:layout_marginTop="4dp" />
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <LinearLayout
                        android:id="@+id/containerEnrolledSpeakers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:layout_weight="1"
                android:padding="12dp"
                android:background="@drawable/bg_session_connection">
                <TextView
                    android:id="@+id/tvAudioFileSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="文字記錄管理"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvTranscriptPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="路徑"
                    android:textColor="#BBBBBB"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:layout_marginTop="3dp" />
                <TextView
                    android:id="@+id/tvNoAudioFilesHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="尚未保存任何文字記錄"
                    android:textColor="#C4CBCD"
                    android:textSize="14sp"
                    android:background="@android:color/transparent"
                    android:visibility="gone"
                    android:layout_marginTop="8dp" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTranscripts"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:nestedScrollingEnabled="false"
                    android:layout_weight="1"
                    android:layout_marginTop="4dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <Button
                        android:id="@+id/btnLoadMoreTranscripts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="載入更多"
                        android:textSize="14sp"
                        android:backgroundTint="#455A64"
                        android:textColor="#FFFFFF"
                        android:visibility="gone"
                        android:minHeight="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp" />
                    <Button
                        android:id="@+id/btnClearTranscripts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="刪除全部記錄"
                        android:textSize="14sp"
                        android:backgroundTint="#734140"
                        android:textColor="#FFFFFF"
                        android:visibility="gone"
                        android:minHeight="48dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
