# IDE and local machine files
*.iml
.DS_Store
.gradle/
.kotlin/
/.idea/
/local.properties
local.properties
# Eclipse/Buildship project files (generated by Gradle IDE import)
.project
.classpath
.settings/
# Agent tooling local state
.omo/

# Android build outputs
/build/
**/build/
/captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.hprof
*.log

# Local notes, generated reports, and backups
/.factory/
/explainFile/
/gesture-backup/

# Secrets and signing material
.env
.env.*
# Keystores are ignored by default, EXCEPT the project release keystore which is
# intentionally committed (password-protected; password lives in GitHub Actions secrets).
# NOTE: the negation must come AFTER the ignore rules - the last matching pattern wins.
*.jks
*.keystore
!app/release.keystore
*.pem
*.p12
keystore.properties
google-services.json
secrets.properties

# Never commit the real Speechmatics API key.
/app/src/main/res/raw/config.json
